# Flask Server Environment Settings
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Speech-to-Text API Tokens (Leave empty to default to Local Free Google Web STT Engine)
DEEPGRAM_API_KEY=your_deepgram_api_token_here
DEEPINFRA_API_KEY=your_deepinfra_api_token_here

# AI Analytics Engine Settings (Leave empty to run Heuristic Fallback processor)
GEMINI_API_KEY=your_google_gemini_api_key_here
